# Copy to backend/.env for local development. Never commit the real .env.

# Last.fm (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
LASTFM_USERNAME=redwheeze

# Monkeytype ApeKey (https://monkeytype.com/account-settings, "ape keys")
APE_KEY=

# GitHub token (optional; raises the Events API rate limit)
GITHUB_API_KEY=
GITHUB_USERNAME=rredwiz

# Spotify (optional; /nowplaying uses it when all three are set, else Last.fm).
# Get the refresh token with `python scripts/spotify_auth.py`; it expires six
# months after you authorize, then run the script again.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Comma-separated list of allowed browser origins, or * (default)
CORS_ORIGINS=*
# Local dev server settings
PORT=5000
FLASK_DEBUG=1
LOG_LEVEL=INFO
